// Renovate for this repository: the rules of the blueprint in
// .github/renovate-blueprint.json5, then those of the project alone below, which
// override them, such as a package that must wait or two that move together:
// https://docs.renovatebot.com/configuration-options/
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>Dennis-Otto/paperless-unified-search//.github/renovate-blueprint.json5"],
  customManagers: [
    {
      // The release of Paperless Sync that the demo installs, with the SHA-256 of its
      // package, which Renovate updates with the version; the pull request runs the
      // demo against it (.github/workflows/demo.yml).
      customType: "regex",
      managerFilePatterns: ["/^demo/seed\\.sh$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=\"(?<currentValue>[^\"]+)\"\\n[A-Z_]+_SHA256=\"(?<currentDigest>[a-f0-9]{64})\"",
      ],
    },
  ],
  packageRules: [
    {
      // The image of Playwright in tests/e2e/run.sh drives only the browsers of the
      // same version of playwright-core in tests/e2e/package.json, so both move in
      // one update; scripts/check-project.sh compares them.
      matchPackageNames: ["mcr.microsoft.com/playwright", "playwright-core"],
      groupName: "Playwright",
    },
    {
      // The contract tests of tests/e2e/compose.paperless.yaml run against the last
      // release of Paperless-ngx 2 and the newest release. Every new release reaches a
      // pull request of its own, apart from the other images, which runs the contract
      // against it. GitHub's auto-merge would wait only for the required checks, which
      // the contract isn't one of; Renovate merges it itself, once every check passed.
      matchPackageNames: ["ghcr.io/paperless-ngx/paperless-ngx"],
      groupName: "Paperless-ngx",
      platformAutomerge: false,
    },
    {
      // The image of version 2 stays within version 2.
      matchPackageNames: ["ghcr.io/paperless-ngx/paperless-ngx"],
      matchCurrentVersion: "/^2\\./",
      allowedVersions: "/^2\\./",
    },
  ],
}
