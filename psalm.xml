<?xml version="1.0"?>
<psalm
	errorLevel="1"
	resolveFromConfigFile="true"
	findUnusedBaselineEntry="true"
	findUnusedCode="true"
	phpVersion="8.2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://getpsalm.org/schema/config"
	xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd">
	<projectFiles>
		<directory name="lib"/>
		<ignoreFiles>
			<directory name="vendor"/>
		</ignoreFiles>
	</projectFiles>
	<!-- The public API of Nextcloud, whose package ships no autoloader of Composer; Psalm
	     finds every other class of vendor/ through the autoloader, when the code uses it,
	     instead of reading all of vendor/ in each run. -->
	<extraFiles>
		<directory name="vendor/nextcloud/ocp"/>
	</extraFiles>
	<stubs>
		<file name="tests/stubs/Emitter.php"/>
	</stubs>
	<!-- What the taint analysis has to know of Nextcloud: the parameters of a request to a
	     controller, the term of a search and the answers of other servers are untrusted
	     input; the paths of files, the addresses of requests to other servers and of
	     redirections are sinks. -->
	<plugins>
		<plugin filename=".github/psalm/NextcloudTaintPlugin.php"/>
	</plugins>
	<issueHandlers>
		<!-- Nextcloud creates some classes itself, by the app's metadata, such as the
		     Application: no code of the app uses them. The suppression keeps Psalm from
		     reporting such a class as unused, but makes no entry point of it, from which
		     Psalm 7 searches for unused code. Every controller is one, by
		     .github/psalm/NextcloudTaintPlugin.php, as with @psalm-api: a controller
		     needs no @psalm-api of its own. -->
		<UnusedClass errorLevel="suppress"/>
		<!-- #[Override] is native only in PHP 8.3; the app supports PHP 8.2. -->
		<MissingOverrideAttribute errorLevel="suppress"/>
	</issueHandlers>
</psalm>
