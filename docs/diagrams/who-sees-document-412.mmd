    subgraph reader ["jamie"]
        shared["… invoice [P412].pdf<br>shared read-only"]
    end
    subgraph other ["sam"]
        copy["Copy [P412].pdf<br>a file of sam's own"]
    end
    seen1(["✓ document 412"])
    seen2(["✓ document 412"])
    unseen(["✗ no document"])

    own -- "share" --> shared
    own --> seen1
    shared --> seen2
    seen2 ~~~ copy
    copy --> unseen

