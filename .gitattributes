# Text with LF line endings everywhere, also in checkouts on Windows.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.zip binary
*.tar.gz binary

# Lock files, which tools write: GitHub folds them in diffs.
requirements*.txt linguist-generated=true
package-lock.json linguist-generated=true
composer.lock linguist-generated=true

# The pictures of the diagrams, which scripts/diagrams.sh draws from docs/diagrams/, and
# those of the page of the automation, which the blueprint brings.
docs/images/diagrams/*.svg linguist-generated=true
.github/mkdocs-blueprint-diagrams/*.svg linguist-generated=true
